# ---------------------------------------------------------------------------
# Akun & sinkronisasi (server sendiri)
# ---------------------------------------------------------------------------
# Kredensial database HANYA untuk server. Jangan pernah memberi prefix VITE_,
# karena semua variabel ber-prefix VITE_ ikut tertanam ke bundle client dan
# bisa dibaca siapa pun yang membuka aplikasi.

# Dipakai Netlify Function untuk terhubung ke MySQL.
DATABASE_URL=mysql://user:password@host:port/database

# require (default, terenkripsi tanpa verifikasi sertifikat), verify (butuh CA),
# atau off.
DB_SSL=require

# Prefix nama tabel yang dibuat aplikasi.
DB_TABLE_PREFIX=fin_

# Masa berlaku token sesi (hari).
AUTH_TOKEN_TTL_DAYS=30

# Opsional: daftar origin yang boleh mengakses API, dipisah koma. Kosongkan
# berarti hanya origin aplikasi sendiri yang diizinkan.
# ALLOWED_ORIGINS=https://contoh.netlify.app

# ---------------------------------------------------------------------------
# Hanya dibutuhkan saat mengembangkan di localhost sambil menunjuk function
# yang sudah ter-deploy. Kosongkan bila memakai `netlify dev`.
# ---------------------------------------------------------------------------
# VITE_API_BASE=https://contoh.netlify.app
